{
  // расширяем основной конфиг всего проекта
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // явно указываем что будем использовать типы из cypress
    // чтобы избежать пересечения с типами jest, если мы его используем
    "types": ["cypress", "node"],
    // добавляем настройку путей
    "paths": {
      "@api": ["utils/burger-api"],
      // при необходимости можно добавить другие алиасы
    }
  },
   "include": ["**/*.ts", "../support/index.d.ts"]
}